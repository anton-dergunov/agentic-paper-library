#!/usr/bin/env bash
# paperlib: runs the engine's command line in the engine's own environment.
# Link it onto your PATH (ln -s "$PWD/bin/paperlib" ~/.local/bin/); uv creates
# and syncs the environment from pyproject.toml on first use.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ENGINE="$(cd "$(dirname "$SOURCE")/.." && pwd)"
exec uv run --quiet --project "$ENGINE" python "$ENGINE/scripts/cli.py" "$@"
